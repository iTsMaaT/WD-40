{
    // Warn if the configuration is not part of the base configuration
    "warnForConfigNotInBaseConfig": true,

    /*
    Types of activities with their corresponding IDs
    - Playing:   0
    - Streaming: 1
    - Listening: 2
    - Watching:  3
    - Custom:    4
    - Competing: 5
    */

    // List of activity statuses for the bot
    "activities": [
        { "type": 2, "name": ">help" },
        { "type": 2, "name": "your freaky songs" },
        { "type": 2, "name": "your freaky playlists" },
        { "type": 4, "name": ">help | Time to be annoying!" },
        { "type": 4, "name": "Do >help for SEX!" },
        { "type": 5, "name": "I am the best, you cannot even compare" },
        { "type": 4, "name": "I think, therefore I think" },
        { "type": 4, "name": "Anon, 'tis time to annoy!" },
        { "type": 4, "name": "Nitro is kinda mid ngl" },
        { "type": 4, "name": "Me omw (on my way) to do >help" },
        { "type": 4, "name": "You have a {statusChance}% chance to see this" },
        { "type": 4, "name": "There is {statusCount} other statuses" },
        { "type": 4, "name": "Tokebac icitte" },
        { "type": 4, "name": "Don't go on page 5 of >help!" },
        { "type": 4, "name": "*you're" },
        { "type": 4, "name": "The time has cum" },
        { "type": 4, "name": "bonjour" },
        { "type": 4, "name": "Use me pwease UwU" },
        { "type": 4, "name": "nuzzles *breaks your spine*" },
        { "type": 4, "name": "That's the gros sourire message" },
        { "type": 4, "name": "Barbeque bacon burger" },
        { "type": 4, "name": "Do you know who else suffers from dementia?" },
        { "type": 4, "name": "Fuck Mee6" },
        { "type": 4, "name": "Amongst Us" },
        { "type": 4, "name": "Ferme ta yeule" },
        { "type": 2, "name": "Yes, enqueued is a word." },
        { "type": 4, "name": "{ipAddress}" },
        { "type": 4, "name": "Currently in {guildCount} guilds" },
        { "type": 4, "name": "fr fr ong no cap" },
        { "type": 4, "name": "You fucking bitch" },
        { "type": 0, "name": "Minecraft, the best game ever." },
        { "type": 0, "name": "Cookie Clicker" },
        { "type": 4, "name": "The byte of 1010111" },
        { "type": 4, "name": "CDUjkju9sy" }
    ],
    
    "defaultPrefix": ">",
    "defaultResponses": false,
    // Default AI personality of the bot
    "defaultPersonality": "Neutral",

    "defaultEmbedColors": {
        "success": "#00FF00", 
        "error": "#FF0000",
        "warning": "#FFFF00",
        "info": "#FFFFFF"
    },

    "cronJobs": {
        "dailyReregister": "0 */12 * * *",
        "activityStatusRotator": "0 3 * * *"
    },
    
    "timeZone": "America/Toronto",
    "locale": "en-US",

    "defaultSuperuserState": false,
    "defaultDebugState": false,

    // Automatically match commands even if not exact
    "autoCommandMatch": true,

    // Base cooldown time for commands (in milliseconds)
    "baseCommandCooldown": 3000,

    // Log rate-limited events
    "logRateLimited": false,

    // Default Gemini model for AI interactions
    "defaultGeminiModel": "gemini-3-flash-preview",

    "discordPlayer": {
        "dailyReregister": false,
        "logPlayerEvents": false,
        "logQueueEvents": false,
        "skipFFmpeg": true,
        // Path to FFmpeg binary, null if global
        "ffmpegPath": null,
        "globalPlayerNodeOptions": {
            "disableSeeker": false,         // Disable seeking in the player
            "volume": 50,
            "maxSize": 10000,               // Maximum size of the queue
            "bufferingTimeout": 15000,      // Timeout for buffering (in ms)
            "leaveOnStop": true,            // Leave the voice channel when stopped
            "leaveOnStopCooldown": 5000,    // Cooldown before leaving (in ms)
            "leaveOnEnd": true,             // Leave the voice channel when the queue ends
            "leaveOnEndCooldown": 15000,    // Cooldown before leaving (in ms)
            "leaveOnEmpty": true,           // Leave the voice channel when empty
            "leaveOnEmptyCooldown": 300000, // Cooldown before leaving (in ms)
            "skipOnNoStream": true          // Skip tracks if no stream is available
        },
        // Supported file extensions for the player (in the ./music folder)
        "supportedFileExtensions": ["mp3", "m4a"],
        "downloadStreams": false,
        "extractors": {
            "Subsonic": {
                "enabled": false,
                "canStream": true,
                "canBridge": false,
                "priority": 15,
                "config": {}
            },
            "Deezer": {
                "enabled": true,
                "canStream": true,
                "canBridge": true,
                "priority": 12,
                "config": {
                    "useAccount": true,             // Use account for Deezer (needed to get streams)
                    "reloadUserInterval": 32400000  // Interval to reload user data (in ms)
                }
            },
            "Youtubei": {
                "enabled": true,
                "canStream": true,
                "canBridge": true,
                "priority": 11,
                "config": {
                    "attemptYoutubeSearchEvenIfDisabled": {
                        "usingScraping": false                 // Attempt to search using scraping
                    },
                    "useCookie": true                          // Use cookies for authentication
                }
            },
            "Soundcloud": {
                "enabled": true,
                "canStream": true,
                "canBridge": true,
                "priority": 10,
                "config": {}
            },
            "Spotify": {
                "enabled": true,
                "canStream": false,
                "canBridge": true,
                "priority": 2,
                "config": {
                    "useAccount": true,             // Use app credentials for Spotify
                    "maxPagingQueries": 100         // Maximum number of paging queries for Spotify (for playlists, albums, etc.)
                }
            },
            "AppleMusic": {
                "enabled": true,
                "canStream": false,
                "canBridge": true,
                "priority": 1,
                "config": {}
            },
            "Soundgasm": {
                "enabled": true,
                "canStream": true,
                "canBridge": false,
                "priority": 1,
                "config": {
                    "skipProbing": true,               // Skip probing for Soundgasm
                    "attemptAlternateProbing": true    // Attempt alternate probing
                }
            },
            "TTS": {
                "enabled": true,
                "canStream": true,
                "canBridge": false,
                "priority": 0,
                "config": {
                    "language": "fr",   // Language for TTS
                    "slow": true        // Slow mode for TTS
                }
            },
            "Attachment": {
                "enabled": true,
                "canStream": true,
                "canBridge": false,
                "priority": 0,
                "config": {}
            }
        },
        "ffmpegFilters": {
            "Surround": [
                "apulsator=hz=0.09"
            ],
            "8D": [
                "apulsator=mode=sine:hz=0.125:amount=0.6",
                "crossfeed=strength=0.4",
                "aecho=0.9:0.9:40|70:0.15|0.1"
            ],
            "16D": [
                "apulsator=mode=sine:hz=0.2:amount=0.7",
                "stereotools=mlev=0.8:slev=1.8",
                "crossfeed=strength=0.4",
                "aecho=0.9:0.9:40|70:0.15|0.1"
            ],
            "Earrape": [
                "earwax",
                "equalizer=f=1000:t=q:w=1:g=48",
                "bass=g=40",
                "dynaudnorm=f=400"
            ],
            "Vaporwave": [
                "asetrate=38400",
                "aresample=48000",
                "aecho=0.8:0.88:60:0.4"
            ],
            "Nightcore": [
                "asetrate=60000",
                "aresample=48000"
            ],
            "LoFi": [
                "asetrate=43200",
                "aresample=48000",
                "extrastereo=m=2.5:c=disabled"
            ],
            "Underwater": [
                "lowpass=f=600",
                "aecho=0.8:0.7:40:0.5"
            ],
            "Chipmunk": [
                "asetrate=48000*1.25",
                "aresample=48000"
            ],
            "Reverb": [
                "aecho=0.8:0.9:1000|1800:0.3|0.25"
            ],
            "Radio": [
                "highpass=f=200",
                "lowpass=f=5000",
                "acompressor"
            ],
            "8-bit": [
                "acrusher=bits=8:mode=log:aa=1",
                "aresample=22050"
            ],
            "ReverseEcho": [
                "aecho=0.6:0.3:500:0.5"
            ],
            "Wide": [
                "extrastereo=m=3"
            ]
        }
    }
}