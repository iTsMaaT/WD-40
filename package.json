    "code": "git pull && npm i && code WD-40.code-workspace && eslint --no-fix . && npm run cl",
    "c": "npm run code",
    "createChangelogMD": "node ./utils/helpers/createChangelogMD.js",
    "cl": "npm run createChangelogMD",
    "generateChangelogEntry": "node ./utils/helpers/generateChangelogEntry.js",
    "gce": "npm run generateChangelogEntry",
    "updateall": "npx npm-check-updates -u && npm i"
